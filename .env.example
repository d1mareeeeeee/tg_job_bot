# ============================================================================
#  Конфигурация Telegram-бота подбора вакансий.
#  Скопируйте этот файл в .env и заполните значения. Файл .env не коммитить!
# ============================================================================

# --- Каналы для мониторинга (username или ссылки, через запятую) ---
# Чтение идёт через публичное веб-превью t.me/s/<username> — БЕЗ api-ключа.
# Поддерживаются только ПУБЛИЧНЫЕ каналы: @it_jobs, remote_devs,
# https://t.me/some_channel. Приватные каналы и инвайт-ссылки (t.me/+..., joinchat)
# так читать нельзя — они будут пропущены с предупреждением в логе.
CHANNELS=@examplejobs,@remotework

# --- Бот-уведомитель (отдельный бот от @BotFather для отправки вам в личку) ---
NOTIFY_BOT_TOKEN=1234567890:AA...your_bot_token
# Ваш личный Telegram user id (узнать через @userinfobot).
NOTIFY_CHAT_ID=123456789

# --- LLM ---
# Провайдер: openai | anthropic | gemini
# Для OpenRouter (и других OpenAI-совместимых API) выбирайте openai + LLM_BASE_URL.
LLM_PROVIDER=openai
# Модель — ОБЯЗАТЕЛЬНО (если пусто, программа завершится с ошибкой).
# Обычный OpenAI: gpt-4o-mini и т.п. Для OpenRouter — id в его формате
# (провайдер/модель), напр. openai/gpt-4o-mini, inclusionai/ling-3.0-flash:free.
LLM_MODEL=openai/gpt-4o-mini
# Ключ API выбранного провайдера (для OpenRouter — ключ вида sk-or-...).
LLM_API_KEY=sk-...your_key
# Кастомный эндпоинт OpenAI-совместимого API. Пусто = стандартный OpenAI.
# OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=
# Просить строгий JSON (response_format). Поставьте false, если модель на
# OpenRouter не поддерживает json_object и запросы падают.
LLM_JSON_MODE=true
# Разрешать только бесплатные модели OpenRouter: true = если модель платная,
# запуск падает с ошибкой (проверка через OpenRouter /models). Для обычного
# OpenAI/Anthropic/Gemini проверка не применяется.
LLM_REQUIRE_FREE=false

# --- Логика подбора ---
# Порог оценки (0-100), выше которого вакансия присылается вам.
MATCH_THRESHOLD=50
# Период опроса каналов, минут. Влияет ТОЛЬКО на свежесть уведомлений: на число
# вызовов LLM не влияет (обработанные посты не оцениваются повторно), на потери —
# тоже, если LOOKBACK_MESSAGES подобран верно. Ставить меньше 5 обычно не нужно:
# нагрузка на t.me растёт линейно, а выигрыш только в задержке.
POLL_INTERVAL_MINUTES=10

# Сколько последних постов проверять на канал за один цикл. САМЫЙ ВАЖНЫЙ ПАРАМЕТР
# для полноты: за цикл бот видит только это число свежих постов, и если канал успел
# опубликовать больше, лишние теряются НАВСЕГДА — окно уезжает вперёд.
# Как подобрать: значение должно быть заметно больше самой крупной пачки, которую
# канал выдаёт за один период опроса. Каналы-агрегаторы вакансий нередко публикуют
# по 10-15 постов за минуту, поэтому 20 — разумный минимум, а при интервале от
# 30 минут стоит брать 30-50.
# Цена вопроса: страница t.me/s/ отдаёт 13-20 текстовых постов, поэтому значение
# выше ~13 может добавить второй HTTP-запрос на канал за цикл. На вызовы LLM не влияет.
LOOKBACK_MESSAGES=20

# Окно ПЕРВОГО цикла после запуска. Нужно, если бот работает не круглосуточно:
# за ночь или выходные канал успевает выложить больше постов, чем помещается в
# обычное окно, а всё, что в него не попало, теряется безвозвратно.
# Платится один раз за запуск, поэтому значение можно брать с большим запасом.
# Ориентир: 100 покрывает перерыв в несколько суток. Если меньше LOOKBACK_MESSAGES,
# расширение не применяется.
STARTUP_LOOKBACK_MESSAGES=100

# --- Первый запуск ---
# true = пометить существующие старые посты как обработанные БЕЗ отправки
# (чтобы не спамить старыми вакансиями). То же самое делает флаг --init.
FIRST_RUN_SILENT=false

# --- Rate-limit (секунды задержки, чтобы не ловить лимиты) ---
# У бесплатных моделей OpenRouter лимит 20 запросов в МИНУТУ (сверх суточного).
# Задержка 1.0 сек даёт 60 запросов в минуту — втрое больше лимита, и на пачке
# постов посыплются 429. Безопасное значение: 3.0 сек и выше (4.0 = 15 в минуту
# с запасом). Для платных провайдеров можно вернуть 1.0.
LLM_RATE_DELAY=4.0
NOTIFY_RATE_DELAY=1.0

# --- Реакция на сбои LLM ---
# Сколько сбоев вызова LLM подряд считать «провайдер лежит». Такие посты не
# помечаются обработанными и будут оценены в следующем цикле.
LLM_FAILURE_STREAK=3
# На сколько минут уснуть после серии сбоев (вместо POLL_INTERVAL_MINUTES).
LLM_BACKOFF_MINUTES=30

# --- Веб-парсер t.me/s/ (можно не менять) ---
# User-Agent для запросов к t.me. Пусто = реалистичный дефолт браузера.
HTTP_USER_AGENT=
# Таймаут HTTP-запроса, секунды.
HTTP_TIMEOUT=20.0

# --- Пути (можно не менять) ---
RESUME_PATH=resume.txt
DB_PATH=job_bot.sqlite3
LOG_PATH=job_bot.log
