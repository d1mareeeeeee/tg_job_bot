# Секреты — НИКОГДА не коммитить (в репозитории остаётся только .env.example).
# Шаблон .env* ловит и варианты вроде .env.local / .env.production — самый частый
# способ утечки в публичных репозиториях.
.env
.env.*
!.env.example

# Ключи, сертификаты, учётные данные — на случай, если когда-нибудь появятся
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
known_hosts
*credentials*
*secrets*

# Личные данные: реальные резюме/профиль (в репо только *.example)
resume.txt
positions.txt

# Виртуальное окружение (пересоздаётся на каждой машине; своё под каждую ОС)
.venv/
.venv-win/
venv/

# Сессии Telethon (если вдруг появятся)
*.session

# База данных и логи бота
job_bot.sqlite3
job_bot.sqlite3-shm
job_bot.sqlite3-wal
job_bot.log

# Кэш Python
__pycache__/
*.pyc
*.pyo

# Служебные файлы ОС/редактора
.DS_Store

# Локальные настройки Claude Code целиком: содержат машинно-зависимые пути,
# имена учётных записей и разрешения. Игнорируем папку, а не отдельный файл —
# иначе любой новый файл внутри неё попадёт в коммит.
.claude/

# Дампы БД и прочие выгрузки
*.sql
*.dump
